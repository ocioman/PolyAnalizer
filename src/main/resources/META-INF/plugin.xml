<idea-plugin>
    <id>io.github.ocioman.hierarchy-tree</id>
    <name>PolyAnalizer</name>
    <vendor>ocioman</vendor>
    <description><![CDATA[
        Displays Java hierarchies, static method selection and dynamic dispatch observed in the debugger.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="PolyAnalizer"
                anchor="right"
                secondary="true"
                icon="/icons/polyAnalizerToolWindow.svg"
                factoryClass="io.github.ocioman.hierarchytree.ui.HierarchyTreeToolWindowFactory"/>
    </extensions>

    <actions>
        <action
                id="HierarchyTree.AnalyzeHierarchy"
                class="io.github.ocioman.hierarchytree.action.AnalyzeHierarchyAction"
                text="Analyze Hierarchy"
                description="Shows supertypes, subtypes and wildcards of the selected class">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="HierarchyTree.AnalyzeDispatch"
                class="io.github.ocioman.hierarchytree.action.AnalyzeDispatchAction"
                text="Explain Static Dispatch"
                description="Shows signature, candidates and specificity criteria of the selected call">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="HierarchyTree.CaptureDynamicDispatch"
                class="io.github.ocioman.hierarchytree.action.CaptureDynamicDispatchAction"
                text="Capture Dynamic Dispatch"
                description="Reads the actual receiver and method observed in the suspended Java frame">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
