<idea-plugin>
    <id>io.github.lorenzoandreotta.hierarchy-tree</id>
    <name>Hierarchy Tree</name>
    <vendor>Lorenzo Andreotta</vendor>
    <description><![CDATA[
        Visualizza gerarchie Java, selezione statica dei metodi e dispatch dinamico osservato nel debugger.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Hierarchy Tree"
                anchor="right"
                secondary="true"
                icon="AllIcons.Nodes.Class"
                factoryClass="io.github.lorenzoandreotta.hierarchytree.ui.HierarchyTreeToolWindowFactory"/>
    </extensions>

    <actions>
        <action
                id="HierarchyTree.AnalyzeHierarchy"
                class="io.github.lorenzoandreotta.hierarchytree.action.AnalyzeHierarchyAction"
                text="Analizza gerarchia"
                description="Mostra supertipi, sottotipi e wildcard della classe selezionata">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
                id="HierarchyTree.AnalyzeDispatch"
                class="io.github.lorenzoandreotta.hierarchytree.action.AnalyzeDispatchAction"
                text="Spiega dispatch statico"
                description="Mostra firma, candidati e criterio di specificità della chiamata selezionata">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
